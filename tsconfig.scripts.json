// Type-checks the standalone tooling in scripts/, which the main tsconfig
// excludes so it never enters the Next.js production build.
//   npx tsc -p tsconfig.scripts.json --noEmit
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
