<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  BSS Signature — Outlook Add-in Manifest Template
  ─────────────────────────────────────────────────
  Replace every placeholder before sideloading or submitting to AppSource:

    YOUR_ADDIN_GUID          → A unique GUID for this add-in.
                               Generate one at: https://guidgenerator.com
                               Must be different for each environment (local / staging / production).

    YOUR_APP_DOMAIN          → The hostname where the app is deployed.
                               Examples: localhost:3000 | staging.yourcompany.com | yourcompany.com

    YOUR_AZURE_AD_CLIENT_ID  → The "Application (client) ID" from your Azure AD App Registration.
                               See SETUP.md → "Azure AD Setup" for instructions.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">

  <!-- Basic Settings -->
  <Id>YOUR_ADDIN_GUID</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Your Company Name</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="BSS Signature"/>
  <Description DefaultValue="Automatically applies your company email signature in Outlook."/>
  <IconUrl DefaultValue="https://YOUR_APP_DOMAIN/icon-80.png"/>
  <HighResolutionIconUrl DefaultValue="https://YOUR_APP_DOMAIN/icon-80.png"/>
  <SupportUrl DefaultValue="https://YOUR_APP_DOMAIN"/>

  <!-- Hosts -->
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <!-- Requirements -->
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <!-- Form Settings -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://YOUR_APP_DOMAIN/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- Permissions -->
  <Permissions>ReadWriteItem</Permissions>

  <!-- Rules -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <!-- Version Overrides -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">

      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">

          <Runtimes>
            <Runtime resid="commandsUrl">
              <Override type="javascript" resid="commandsUrl"/>
            </Runtime>
          </Runtimes>

          <DesktopFormFactor>
            <FunctionFile resid="commandsUrl"/>

            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="bssSignatureGroup">
                  <Label resid="groupLabel"/>

                  <Control xsi:type="Button" id="btnTaskpane">
                    <Label resid="taskpaneLabel"/>
                    <Supertip>
                      <Title resid="taskpaneLabel"/>
                      <Description resid="taskpaneDesc"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneUrl"/>
                    </Action>
                  </Control>

                  <Control xsi:type="Button" id="btnInsertSignature">
                    <Label resid="insertLabel"/>
                    <Supertip>
                      <Title resid="insertLabel"/>
                      <Description resid="insertDesc"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>insertSignature</FunctionName>
                    </Action>
                  </Control>

                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="autoInsertSignature"/>
              </LaunchEvents>
              <SourceLocation resid="commandsUrl"/>
            </ExtensionPoint>

          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://YOUR_APP_DOMAIN/icon-16.png"/>
          <bt:Image id="icon32" DefaultValue="https://YOUR_APP_DOMAIN/icon-32.png"/>
          <bt:Image id="icon80" DefaultValue="https://YOUR_APP_DOMAIN/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="commandsUrl" DefaultValue="https://YOUR_APP_DOMAIN/commands.html"/>
          <bt:Url id="taskpaneUrl" DefaultValue="https://YOUR_APP_DOMAIN/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="BSS Signature"/>
          <bt:String id="taskpaneLabel" DefaultValue="Sign In"/>
          <bt:String id="insertLabel" DefaultValue="Insert Signature"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="taskpaneDesc" DefaultValue="Sign in to authenticate before inserting your signature."/>
          <bt:String id="insertDesc" DefaultValue="Insert your BSS email signature"/>
        </bt:LongStrings>
      </Resources>

      <!--
        WebApplicationInfo links this add-in to your Azure AD App Registration,
        enabling SSO and secure token exchange with the signature API.
      -->
      <WebApplicationInfo>
        <Id>YOUR_AZURE_AD_CLIENT_ID</Id>
        <Resource>api://YOUR_APP_DOMAIN/YOUR_AZURE_AD_CLIENT_ID</Resource>
        <Scopes>
          <Scope>openid</Scope>
          <Scope>profile</Scope>
          <Scope>access_as_user</Scope>
        </Scopes>
      </WebApplicationInfo>

    </VersionOverrides>
  </VersionOverrides>

</OfficeApp>
