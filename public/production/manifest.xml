<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">

  <!-- Basic Settings -->
  <Id>b94f9d12-3e76-4c95-8b01-2a73f5c4e8d1</Id>
  <Version>1.0.7.0</Version>
  <ProviderName>Blackstone Shipping</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="BSS Signature"/>
  <Description DefaultValue="Automatically applies your company email signature in Outlook."/>
  <IconUrl DefaultValue="https://blackstone.simtechitsolutions.in/icon-80.png"/>
  <HighResolutionIconUrl DefaultValue="https://blackstone.simtechitsolutions.in/icon-80.png"/>
  <SupportUrl DefaultValue="https://blackstone.simtechitsolutions.in"/>

  <!-- Hosts -->
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <!-- Requirements -->
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <!-- Form Settings -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://blackstone.simtechitsolutions.in/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- Permissions -->
  <Permissions>ReadWriteItem</Permissions>

  <!-- Rules -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <!-- Version Overrides -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">

      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">

          <Runtimes>
            <!-- Runtime resid (HTML) = browser runtime used by Outlook on the web and new Outlook on Windows.
                 Override type="javascript" (JS file) = JavaScript-only runtime used by classic Outlook on Windows.
                 These MUST point to different files: classic Outlook executes the Override resid AS JavaScript. -->
            <Runtime resid="commandsUrl">
              <Override type="javascript" resid="commandsJsUrl"/>
            </Runtime>
          </Runtimes>

          <DesktopFormFactor>
            <FunctionFile resid="commandsUrl"/>

            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="bssSignatureGroup">
                  <Label resid="groupLabel"/>

                  <Control xsi:type="Button" id="btnInsertSignature">
                    <Label resid="insertLabel"/>
                    <Supertip>
                      <Title resid="insertLabel"/>
                      <Description resid="insertDesc"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneUrl"/>
                    </Action>
                  </Control>

                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="autoInsertSignature"/>
              </LaunchEvents>
              <SourceLocation resid="commandsUrl"/>
            </ExtensionPoint>

          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://blackstone.simtechitsolutions.in/icon-80.png"/>
          <bt:Image id="icon32" DefaultValue="https://blackstone.simtechitsolutions.in/icon-80.png"/>
          <bt:Image id="icon80" DefaultValue="https://blackstone.simtechitsolutions.in/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="commandsUrl" DefaultValue="https://blackstone.simtechitsolutions.in/commands.html"/>
          <bt:Url id="commandsJsUrl" DefaultValue="https://blackstone.simtechitsolutions.in/commands.js"/>
          <bt:Url id="taskpaneUrl" DefaultValue="https://blackstone.simtechitsolutions.in/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="BSS Signature"/>
          <bt:String id="insertLabel" DefaultValue="Insert Signature"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="insertDesc" DefaultValue="Insert your BSS email signature"/>
        </bt:LongStrings>
      </Resources>

      <WebApplicationInfo>
        <Id>80c4e4bb-8b7f-4a99-8364-ee587b08670d</Id>
        <Resource>api://blackstone.simtechitsolutions.in/80c4e4bb-8b7f-4a99-8364-ee587b08670d</Resource>
        <Scopes>
          <Scope>openid</Scope>
          <Scope>profile</Scope>
          <Scope>access_as_user</Scope>
        </Scopes>
      </WebApplicationInfo>

    </VersionOverrides>
  </VersionOverrides>

</OfficeApp>
